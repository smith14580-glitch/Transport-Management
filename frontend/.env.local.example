# Copy to .env.local and fill in real values. Never commit .env.local.
# NEXT_PUBLIC_API_URL = the FastAPI backend base URL (no trailing slash).
# Leave it UNSET to run in demo mode (localStorage sample data, with a
# visible "Demo data — no backend connected yet" banner).
# Example local dev: http://localhost:8000
# Example production (Render): https://hk-transport-api.onrender.com
# NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=HK Transport
